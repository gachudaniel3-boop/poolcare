# Copy to .env on the server. Never include a real .env file in browser assets.
PORT=5000
HOST=0.0.0.0
# Set to true only when the server is behind a trusted reverse proxy.
TRUST_PROXY=false
# Replace with the connection string from your MongoDB Atlas cluster.
# URL-encode special characters in the database username and password.
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/poolcare?retryWrites=true&w=majority

# Configure a long, unique administrator password on the server.
ADMIN_PASSWORD=replace_with_a_long_random_admin_password

# Cloudinary secrets stay on the Express server; only stored media URLs reach clients.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_your_cloudinary_api_secret
